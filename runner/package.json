{
  "name": "@ferrobot/runner",
  "version": "0.1.3",
  "description": "In-sandbox agent runner: drives Claude via the Claude Agent SDK and talks to ferrobotd over WebSocket.",
  "license": "(MIT OR Apache-2.0)",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node --test --test-timeout=30000 \"test/**/*.test.ts\"",
    "format": "prettier --write --ignore-path ../.prettierignore .",
    "format:check": "prettier --check --ignore-path ../.prettierignore ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.328",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.23.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "eslint": "^10.0.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
