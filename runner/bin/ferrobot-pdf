#!/bin/sh
# Renders an HTML file (or an http(s) URL) to PDF with headless Chromium.
# Usage: ferrobot-pdf <page.html|https://...> <out.pdf>
set -eu
if [ "$#" -ne 2 ]; then
  echo "usage: ferrobot-pdf <page.html|https://...> <out.pdf>" >&2
  exit 2
fi
case "$1" in
  http://* | https://*) src="$1" ;;
  *) src="file://$(realpath "$1")" ;;
esac
out="$(realpath -m "$2")"
log="${TMPDIR:-/tmp}/ferrobot-pdf.log"
rm -f "$out"
# The container is the sandbox; Chromium's own needs privileges it lacks here.
chromium --headless --no-sandbox --disable-gpu --disable-dev-shm-usage \
  --no-pdf-header-footer --print-to-pdf-no-header \
  --virtual-time-budget=10000 --print-to-pdf="$out" "$src" >/dev/null 2>"$log" || true
if [ -s "$out" ]; then
  echo "wrote $out"
else
  echo "ferrobot-pdf: could not render $1" >&2
  tail -n 5 "$log" >&2
  exit 1
fi
