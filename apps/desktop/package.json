{
  "name": "@ferrobot/desktop",
  "version": "0.1.3",
  "description": "Thin Tauri desktop UI for ferrobotd (Preact + Vite).",
  "license": "(MIT OR Apache-2.0)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "gen:api": "openapi-typescript ../../protocol/openapi.json -o src/generated/api-types.ts",
    "check:api": "openapi-typescript ../../protocol/openapi.json -o src/generated/api-types.ts && git diff --exit-code -- src/generated",
    "tauri": "tauri",
    "lint": "eslint .",
    "format": "prettier --write --ignore-path ../../.prettierignore \"src/**/*.{ts,tsx}\" \"test/**/*.ts\" \"*.{ts,js}\"",
    "format:check": "prettier --check --ignore-path ../../.prettierignore \"src/**/*.{ts,tsx}\" \"test/**/*.ts\" \"*.{ts,js}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "lucide-preact": "^1.76.0",
    "preact": "^10.29.8"
  }
}
