{
  "name": "@ferrobot/desktop",
  "version": "0.1.0",
  "description": "Thin Tauri desktop UI for ferrobotd (Preact + Vite).",
  "license": "(MIT OR Apache-2.0)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "gen:api": "openapi-typescript ../../protocol/openapi.json -o src/generated/api-types.ts",
    "check:api": "openapi-typescript ../../protocol/openapi.json -o src/generated/api-types.ts && git diff --exit-code -- src/generated",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^24.19.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "lucide-preact": "^1.76.0",
    "preact": "^10.29.8"
  }
}
