{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ferrobot",
  "version": "0.1.0",
  "identifier": "dev.ferrobot.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run build"
  },
  "app": {
    "windows": [{ "title": "ferrobot", "width": 1100, "height": 720, "minWidth": 720, "minHeight": 480 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' http://127.0.0.1:7878 ws://127.0.0.1:7878"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
