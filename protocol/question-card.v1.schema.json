{
  "$defs": {
    "Account": {
      "description": "Where a CLI's token goes: only requests to `hosts` get it; the CLI holds a stand-in.",
      "properties": {
        "confirm": {
          "description": "Ask before every command that runs one of the CLI's programs or names one of `env` or\n`hosts`, unless Auto mode is on.",
          "type": "boolean"
        },
        "env": {
          "description": "Environment variables the CLI reads its token from, e.g. `EXAMPLE_API_KEY`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "hosts": {
          "description": "API hosts whose requests get the real token, exact public names like `api.example.com`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sign_in": {
          "oneOf": [
            {
              "$ref": "#/$defs/CliSignIn",
              "description": "The CLI's own device sign-in; without it the operator pastes a token."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "hosts",
        "env"
      ],
      "type": "object"
    },
    "AgentId": {
      "description": "Stable, opaque identifier of an agent.",
      "format": "uuid",
      "type": "string"
    },
    "Approval": {
      "description": "What an approval card asks the operator to allow; the decision goes to the waiting tool\ncall, not to the agent's mailbox.",
      "oneOf": [
        {
          "description": "An agent wants to create another agent (`create_agent` tool).",
          "properties": {
            "description": {
              "description": "Requested one-line description (role).",
              "type": "string"
            },
            "kind": {
              "enum": [
                "create_agent"
              ],
              "type": "string"
            },
            "name": {
              "description": "Requested name of the new agent.",
              "type": "string"
            }
          },
          "required": [
            "name",
            "description",
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "An agent wants to add a connector (`add_connector` tool). Approving creates it and gives\nit to the agent; a token, if it takes one, goes in under Settings, never on a card.",
          "properties": {
            "auth": {
              "$ref": "#/$defs/ConnectorAuth"
            },
            "command": {
              "description": "A local server's program and arguments (it runs on the daemon's computer).",
              "items": {
                "type": "string"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "kind": {
              "enum": [
                "add_connector"
              ],
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "requester": {
              "$ref": "#/$defs/AgentId",
              "description": "The agent that asked: it gets the connector and a message with the outcome."
            },
            "token_env": {
              "type": [
                "string",
                "null"
              ]
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "url",
            "auth",
            "requester",
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "An agent wants a CLI in its computer (`propose_cli` tool). Approving adds it for that\nagent; a token, if it needs one, goes in under Settings, never on a card.",
          "properties": {
            "cli": {
              "$ref": "#/$defs/Cli"
            },
            "kind": {
              "enum": [
                "add_cli"
              ],
              "type": "string"
            },
            "requester": {
              "$ref": "#/$defs/AgentId"
            }
          },
          "required": [
            "cli",
            "requester",
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "An agent wants a routine of its own (`create_routine` tool): `prompt` reaches it on\n`schedule` (cron, the daemon's time zone).",
          "properties": {
            "kind": {
              "enum": [
                "create_routine"
              ],
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "prompt": {
              "type": "string"
            },
            "requester": {
              "$ref": "#/$defs/AgentId"
            },
            "schedule": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "schedule",
            "prompt",
            "requester",
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "An agent wants to give an agent it created more tools (`set_agent_tools` tool). The new\nsets replace the target's; `null` leaves that set as it is.",
          "properties": {
            "agent": {
              "$ref": "#/$defs/AgentId"
            },
            "connectors": {
              "description": "Connector ids.",
              "items": {
                "format": "uuid",
                "type": "string"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "kind": {
              "enum": [
                "set_agent_tools"
              ],
              "type": "string"
            },
            "requester": {
              "$ref": "#/$defs/AgentId"
            },
            "tools": {
              "items": {
                "$ref": "#/$defs/ToolGroup"
              },
              "type": [
                "array",
                "null"
              ]
            }
          },
          "required": [
            "agent",
            "requester",
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "The agent's model refused a request with tools (raised by the daemon). Approving turns\noff its tool groups and connectors so its waiting messages run as plain chat.",
          "properties": {
            "agent": {
              "$ref": "#/$defs/AgentId"
            },
            "kind": {
              "enum": [
                "use_without_tools"
              ],
              "type": "string"
            },
            "model": {
              "type": "string"
            }
          },
          "required": [
            "agent",
            "model",
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "The tool-call classifier flagged a call as risky and Auto mode is off: the call waits\nfor the operator.",
          "properties": {
            "agent": {
              "$ref": "#/$defs/AgentId"
            },
            "critical": {
              "description": "A very risky step (money, deleting in a connected service, force-pushing,\npublishing): Auto mode still asks, and only the app answers it.",
              "type": "boolean"
            },
            "detail": {
              "description": "The command or the call's arguments, shortened.",
              "type": "string"
            },
            "kind": {
              "enum": [
                "tool_call"
              ],
              "type": "string"
            },
            "reason": {
              "description": "What made the call risky, e.g. \"pushes code\".",
              "type": "string"
            },
            "tool": {
              "description": "`shell` or the connector tool's name.",
              "type": "string"
            }
          },
          "required": [
            "agent",
            "tool",
            "detail",
            "reason",
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "Choice": {
      "description": "One selectable option.",
      "properties": {
        "label": {
          "description": "Shown to the user.",
          "type": "string"
        },
        "value": {
          "description": "Stable value reported in the answer; defaults to the label.",
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "Cli": {
      "description": "A CLI in the agents' computers.",
      "properties": {
        "account": {
          "oneOf": [
            {
              "$ref": "#/$defs/Account"
            },
            {
              "type": "null"
            }
          ]
        },
        "agents": {
          "description": "Agents that get it in their home folder and get its account. A Debian package is in\nevery computer.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "1-63 chars of `a-z0-9.+-`, starting with a letter or digit, e.g. `example`.",
          "type": "string"
        },
        "install": {
          "$ref": "#/$defs/Install"
        },
        "programs": {
          "description": "The programs it brings, e.g. `[\"example\"]`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "install"
      ],
      "type": "object"
    },
    "CliSignIn": {
      "description": "A CLI's own browser sign-in that shows a one-time code (device login).",
      "properties": {
        "login": {
          "description": "The login command, e.g. `[\"example\", \"auth\", \"login\", \"--web\"]`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "token": {
          "description": "The command that prints the token afterwards, e.g. `[\"example\", \"auth\", \"token\"]`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "login",
        "token"
      ],
      "type": "object"
    },
    "ConnectorAuth": {
      "description": "How a connector an agent proposes signs in (`add_connector` tool).",
      "enum": [
        "token",
        "oauth",
        "none"
      ],
      "type": "string"
    },
    "Install": {
      "description": "How a CLI gets into the computers.",
      "oneOf": [
        {
          "description": "A Debian package in the image every computer starts from.",
          "properties": {
            "kind": {
              "enum": [
                "debian"
              ],
              "type": "string"
            },
            "package": {
              "type": "string"
            }
          },
          "required": [
            "package",
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "An npm package, installed into the home folder of each of its agents.",
          "properties": {
            "kind": {
              "enum": [
                "npm"
              ],
              "type": "string"
            },
            "package": {
              "type": "string"
            }
          },
          "required": [
            "package",
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "A program downloaded into the home folder of each of its agents, as its first program.",
          "properties": {
            "kind": {
              "enum": [
                "download"
              ],
              "type": "string"
            },
            "sha256": {
              "description": "SHA-256 of the file in hex; checked before it is installed.",
              "type": [
                "string",
                "null"
              ]
            },
            "url": {
              "description": "`https://` address of the program itself, not an archive.",
              "type": "string"
            }
          },
          "required": [
            "url",
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "A shell script run in the home folder of each of its agents, as the agent's user, with\n`PREFIX=~/.local`; it should put the CLI in `~/.local/bin`.",
          "properties": {
            "kind": {
              "enum": [
                "script"
              ],
              "type": "string"
            },
            "script": {
              "type": "string"
            }
          },
          "required": [
            "script",
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "Question": {
      "description": "One question on a card.",
      "properties": {
        "allow_custom": {
          "description": "`single`/`multi`: also offer a free-text \"other\" answer.",
          "type": "boolean"
        },
        "choices": {
          "description": "Options for `single` and `multi` (2..12). Empty for `text`.",
          "items": {
            "$ref": "#/$defs/Choice"
          },
          "type": "array"
        },
        "id": {
          "description": "Unique within the card; defaults to `q1`, `q2`, ...",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/QuestionKind"
        },
        "prompt": {
          "description": "The question text.",
          "type": "string"
        }
      },
      "required": [
        "prompt",
        "kind"
      ],
      "type": "object"
    },
    "QuestionAnswer": {
      "description": "The answer to one question.",
      "properties": {
        "custom": {
          "description": "Free text (`text` questions, or \"other\" when `allow_custom`).",
          "type": [
            "string",
            "null"
          ]
        },
        "question_id": {
          "type": "string"
        },
        "values": {
          "description": "Selected choice values (`single`: at most one).",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "question_id"
      ],
      "type": "object"
    },
    "QuestionAnswered": {
      "description": "Payload of a `question_answered` event. A card is answered at most once.",
      "properties": {
        "answers": {
          "items": {
            "$ref": "#/$defs/QuestionAnswer"
          },
          "type": "array"
        },
        "message_id": {
          "description": "The user message that carried the answer to the agent; `null` for\napproval cards (the decision goes to the waiting tool call).",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "question": {
          "description": "Id of the `question` event.",
          "format": "int64",
          "type": "integer"
        },
        "timed_out": {
          "description": "No answer came in time: the daemon declined the approval card.",
          "type": "boolean"
        }
      },
      "required": [
        "question",
        "answers"
      ],
      "type": "object"
    },
    "QuestionCard": {
      "description": "A card with one or more questions, answered together.",
      "properties": {
        "questions": {
          "description": "1..8 questions, shown in order.",
          "items": {
            "$ref": "#/$defs/Question"
          },
          "type": "array"
        },
        "title": {
          "description": "Optional heading.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "questions"
      ],
      "type": "object"
    },
    "QuestionEvent": {
      "description": "Payload of a `question` event: the card as shown in the chat.",
      "properties": {
        "approval": {
          "oneOf": [
            {
              "$ref": "#/$defs/Approval",
              "description": "Set on approval cards raised by the daemon (e.g. for `create_agent`)."
            },
            {
              "type": "null"
            }
          ]
        },
        "card": {
          "$ref": "#/$defs/QuestionCard"
        },
        "turn_id": {
          "description": "The turn that raised the card (its trace shows the wait); `null` outside a turn.",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "description": "Card format version (currently 1).",
          "format": "int32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "card"
      ],
      "type": "object"
    },
    "QuestionKind": {
      "description": "How a question is answered.",
      "enum": [
        "single",
        "multi",
        "text",
        "secret"
      ],
      "type": "string"
    },
    "ToolGroup": {
      "description": "A group of tools an agent can have on or off. The first six are ferrobot's own MCP tools\n(enforced by the daemon), the last three the model's built-in tools (enforced by the runner).",
      "enum": [
        "team",
        "memory",
        "operator",
        "create_agents",
        "add_connectors",
        "routines",
        "shell",
        "files",
        "web"
      ],
      "type": "string"
    }
  },
  "$id": "question-card.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Payload of a `question` event (`QuestionEvent`, the card an agent showed with the `ask_user` MCP tool) or of a `question_answered` event (`QuestionAnswered`).",
  "oneOf": [
    {
      "$ref": "#/$defs/QuestionEvent"
    },
    {
      "$ref": "#/$defs/QuestionAnswered"
    }
  ],
  "title": "ferrobot question card (version 1)"
}
