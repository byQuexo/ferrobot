{
  "$defs": {
    "Agent": {
      "description": "A registered agent. Secrets (the runner token) are never part of this type.",
      "properties": {
        "avatar_rev": {
          "description": "Changes whenever the avatar changes; positive while an avatar exists.",
          "format": "int64",
          "type": "integer"
        },
        "backend": {
          "description": "Backend kind that owns the sandbox, e.g. `docker`.",
          "type": [
            "string",
            "null"
          ]
        },
        "character": {
          "oneOf": [
            {
              "$ref": "#/$defs/AvatarCharacter",
              "description": "Chosen character avatar look; `null` means derived from the id."
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "created_by": {
          "oneOf": [
            {
              "$ref": "#/$defs/AgentId",
              "description": "Agent that created this one (with operator approval); `null` means\nthe operator created it."
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "description": "One-line description shown in agent lists.",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/AgentId"
        },
        "instructions": {
          "description": "Operator-provided role handed to the model as system instructions.",
          "type": "string"
        },
        "model": {
          "description": "Model id; `null` uses the provider's default model.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "$ref": "#/$defs/AgentName",
          "description": "Display and addressing name; unique, can be changed (rename)."
        },
        "pinned": {
          "description": "Pinned to the top of the operator's agent list.",
          "type": "boolean"
        },
        "provider_id": {
          "description": "Model provider (`GET /v1/providers`); `null` uses the daemon's\n`ANTHROPIC_API_KEY`.",
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "sandbox_id": {
          "description": "Backend-specific sandbox identifier (container id, sprite name, ...).",
          "type": [
            "string",
            "null"
          ]
        },
        "sandbox_name": {
          "description": "Stable name of the agent's sandbox resources (container, disk). Set\nat creation and kept on rename.",
          "type": "string"
        },
        "session_id": {
          "description": "Last model session id reported by the runner, used for resume.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/AgentStatus"
        },
        "tags": {
          "description": "The operator's labels for the agent, in order.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tools": {
          "description": "Tool groups the agent may use; its connectors are its assignment.",
          "items": {
            "$ref": "#/$defs/ToolGroup"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "sandbox_name",
        "description",
        "instructions",
        "avatar_rev",
        "status",
        "created_at"
      ],
      "type": "object"
    },
    "AgentId": {
      "description": "Stable, opaque identifier of an agent.",
      "format": "uuid",
      "type": "string"
    },
    "AgentName": {
      "description": "Unique agent handle like `build-bot`: 1-32 chars of `a-z0-9-`, starting with a letter and\nnot ending with `-`, so it stays DNS-safe in sandbox resource names.",
      "example": "alice",
      "pattern": "^[a-z]([a-z0-9-]{0,30}[a-z0-9])?$",
      "type": "string"
    },
    "AgentStatus": {
      "description": "Lifecycle state of an agent's sandbox as tracked by the daemon.",
      "enum": [
        "created",
        "running",
        "paused",
        "stopped",
        "archived",
        "failed"
      ],
      "type": "string"
    },
    "AgentView": {
      "allOf": [
        {
          "$ref": "#/$defs/Agent"
        },
        {
          "properties": {
            "avatar_url": {
              "description": "Relative URL of the avatar image, if one was uploaded.",
              "type": [
                "string",
                "null"
              ]
            },
            "connected": {
              "description": "Whether the agent's runner is connected right now.",
              "type": "boolean"
            },
            "credential_error": {
              "oneOf": [
                {
                  "$ref": "#/$defs/CredentialError",
                  "description": "Set while the agent's model credential is missing or rejected; its turns wait."
                },
                {
                  "type": "null"
                }
              ]
            },
            "last_reply": {
              "oneOf": [
                {
                  "$ref": "#/$defs/LastReply",
                  "description": "The agent's newest reply, cut to a preview."
                },
                {
                  "type": "null"
                }
              ]
            },
            "presence": {
              "$ref": "#/$defs/Presence"
            },
            "tools_unsupported": {
              "oneOf": [
                {
                  "$ref": "#/$defs/ToolsUnsupported",
                  "description": "Set while the agent's model can't use tools and the operator has not turned them off;\nits turns wait."
                },
                {
                  "type": "null"
                }
              ]
            },
            "unread": {
              "description": "Finished turns since the operator last marked the chat as read.",
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            },
            "waiting": {
              "description": "Question cards waiting for the operator's answer.",
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "connected",
            "presence",
            "unread",
            "waiting"
          ],
          "type": "object"
        }
      ],
      "description": "An agent plus live state."
    },
    "AvatarCharacter": {
      "description": "A chosen character avatar look; without one, clients derive a look from the agent id.\nAn uploaded avatar image wins over both.",
      "properties": {
        "body": {
          "$ref": "#/$defs/CharacterBody"
        },
        "eyes": {
          "$ref": "#/$defs/CharacterEyes"
        },
        "hue": {
          "description": "Color hue in degrees, 0..=359.",
          "format": "int32",
          "maximum": 359,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "body",
        "eyes",
        "hue"
      ],
      "type": "object"
    },
    "CharacterBody": {
      "description": "Body shape of the generated character avatar.",
      "enum": [
        "blob",
        "bean",
        "pebble",
        "sprout"
      ],
      "type": "string"
    },
    "CharacterEyes": {
      "description": "Eye style of the generated character avatar.",
      "enum": [
        "dots",
        "ovals",
        "wide",
        "visor"
      ],
      "type": "string"
    },
    "CredentialError": {
      "description": "A model credential problem found by the model proxy. The agent's messages wait until the\noperator changes its provider or model, stores a key or retries. Kept in memory: after a\nrestart the next model call finds it again.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/CredentialProblem"
        },
        "reason": {
          "description": "What is wrong and where to fix it; never contains the key.",
          "type": "string"
        },
        "since": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reason",
        "since"
      ],
      "type": "object"
    },
    "CredentialProblem": {
      "description": "What is wrong with an agent's model credential.",
      "enum": [
        "missing",
        "rejected"
      ],
      "type": "string"
    },
    "LastReply": {
      "description": "The start of an agent's newest reply.",
      "properties": {
        "at": {
          "description": "When the reply came (RFC 3339).",
          "type": "string"
        },
        "text": {
          "description": "At most 160 characters.",
          "type": "string"
        }
      },
      "required": [
        "text",
        "at"
      ],
      "type": "object"
    },
    "MailMessage": {
      "description": "One message in an agent's mailbox.",
      "properties": {
        "attempts": {
          "format": "int32",
          "minimum": 0,
          "type": "integer"
        },
        "body": {
          "description": "Text; mentions of agents are stored as `<@agent-id>` tokens (see\n`ferrobot_core::mention`), so render them with the current names.",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "format": "int64",
          "type": "integer"
        },
        "priority": {
          "description": "`true`: wakes the recipient and goes first; `false`: waits for its next turn\nwithout waking it; `null` (default): queues and wakes.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "recipient": {
          "$ref": "#/$defs/AgentId"
        },
        "reply_to": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "room_id": {
          "description": "The call room whose turn this message carries; such messages stay out of the agent's chat.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "sender": {
          "$ref": "#/$defs/Sender"
        },
        "status": {
          "$ref": "#/$defs/MailStatus"
        }
      },
      "required": [
        "id",
        "sender",
        "recipient",
        "body",
        "status",
        "attempts",
        "created_at"
      ],
      "type": "object"
    },
    "MailStatus": {
      "description": "Delivery state: `pending`, `in_flight`, `delivered`; back to `pending` when a runner\ndisconnects mid-turn, `failed` after too many attempts.",
      "enum": [
        "pending",
        "in_flight",
        "delivered",
        "failed"
      ],
      "type": "string"
    },
    "Presence": {
      "description": "What an agent is doing right now, for status badges.",
      "enum": [
        "working",
        "awake",
        "starting",
        "sleeping",
        "error"
      ],
      "type": "string"
    },
    "Room": {
      "description": "A voice call with two or more agents, kept as history once the call ended; or, with a name,\na group chat, kept until deleted.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "ended_at": {
          "description": "When the call ended; `null` while it runs, and always for a group.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "format": "int64",
          "type": "integer"
        },
        "members": {
          "description": "Every agent that took part (a group: its members), in the order they joined.",
          "items": {
            "$ref": "#/$defs/AgentId"
          },
          "type": "array"
        },
        "name": {
          "description": "The group's name; `null`: a call room.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "members",
        "created_at"
      ],
      "type": "object"
    },
    "RoomLine": {
      "description": "One thing said in a room, by the operator (`user`) or an agent.",
      "properties": {
        "body": {
          "description": "The words; mentions are `<@agent-id>` tokens. With `invited`, the topic that agent got.",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "format": "int64",
          "type": "integer"
        },
        "invited": {
          "description": "The agent this line brought into the call; `null` for words said.",
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "room_id": {
          "format": "int64",
          "type": "integer"
        },
        "speaker": {
          "$ref": "#/$defs/Sender"
        }
      },
      "required": [
        "id",
        "room_id",
        "speaker",
        "body",
        "created_at"
      ],
      "type": "object"
    },
    "Sender": {
      "description": "Who sent a mailbox message.",
      "oneOf": [
        {
          "description": "The human operator, via the UI or HTTP API.",
          "properties": {
            "kind": {
              "enum": [
                "user"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Another agent, via the `send_message` MCP tool.",
          "properties": {
            "id": {
              "$ref": "#/$defs/AgentId",
              "description": "Another agent, via the `send_message` MCP tool."
            },
            "kind": {
              "enum": [
                "agent"
              ],
              "type": "string"
            }
          },
          "required": [
            "id",
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "A scheduled routine (by routine id).",
          "properties": {
            "id": {
              "description": "A scheduled routine (by routine id).",
              "format": "int64",
              "type": "integer"
            },
            "kind": {
              "enum": [
                "routine"
              ],
              "type": "string"
            }
          },
          "required": [
            "id",
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "An incoming webhook (by webhook id); its body is external data, framed as such. Runners\nget its turns as `user` with `sender_name` `webhook:<name>`.",
          "properties": {
            "id": {
              "description": "An incoming webhook (by webhook id); its body is external data, framed as such. Runners\nget its turns as `user` with `sender_name` `webhook:<name>`.",
              "format": "int64",
              "type": "integer"
            },
            "kind": {
              "enum": [
                "webhook"
              ],
              "type": "string"
            }
          },
          "required": [
            "id",
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "StoredEvent": {
      "description": "One recorded event in an agent's chat.",
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/AgentId"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "format": "int64",
          "type": "integer"
        },
        "kind": {
          "type": "string"
        },
        "payload": {
          "description": "The event body; for runner events this is a `TurnEvent`.",
          "type": "object"
        },
        "turn_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "agent_id",
        "kind",
        "payload",
        "created_at"
      ],
      "type": "object"
    },
    "ToolGroup": {
      "description": "A group of tools an agent can have on or off. The first six are ferrobot's own MCP tools\n(enforced by the daemon), the last three the model's built-in tools (enforced by the runner).",
      "enum": [
        "team",
        "memory",
        "operator",
        "create_agents",
        "add_connectors",
        "routines",
        "shell",
        "files",
        "web"
      ],
      "type": "string"
    },
    "ToolsUnsupported": {
      "description": "The agent's model refused a request with tools. The agent's messages wait until the operator\napproves the card to run it without tools, changes its provider or model, or retries. Kept in\nmemory: after a restart the next model call finds it again.",
      "properties": {
        "model": {
          "description": "The model as the agent requested it.",
          "type": "string"
        },
        "reason": {
          "description": "Which provider can't run the model with tools; never the upstream's words.",
          "type": "string"
        },
        "since": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "model",
        "reason",
        "since"
      ],
      "type": "object"
    },
    "UiEvent": {
      "description": "Pushed to every UI WebSocket client.",
      "oneOf": [
        {
          "description": "A turn event was recorded (same shape as `GET /v1/agents/{id}/events`).",
          "properties": {
            "event": {
              "$ref": "#/$defs/StoredEvent"
            },
            "type": {
              "enum": [
                "event"
              ],
              "type": "string"
            }
          },
          "required": [
            "event",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Live text of the assistant message being written; not persisted, the final\n`assistant_text` event replaces it.",
          "properties": {
            "agent_id": {
              "$ref": "#/$defs/AgentId"
            },
            "text": {
              "type": "string"
            },
            "turn_id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "delta"
              ],
              "type": "string"
            }
          },
          "required": [
            "agent_id",
            "turn_id",
            "text",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "An agent was created or changed (profile, presence, unread count).",
          "properties": {
            "agent": {
              "$ref": "#/$defs/AgentView"
            },
            "type": {
              "enum": [
                "agent"
              ],
              "type": "string"
            }
          },
          "required": [
            "agent",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "An agent was deleted.",
          "properties": {
            "agent_id": {
              "$ref": "#/$defs/AgentId"
            },
            "type": {
              "enum": [
                "agent_deleted"
              ],
              "type": "string"
            }
          },
          "required": [
            "agent_id",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A mailbox message was queued or changed status.",
          "properties": {
            "message": {
              "$ref": "#/$defs/MailMessage"
            },
            "type": {
              "enum": [
                "message"
              ],
              "type": "string"
            }
          },
          "required": [
            "message",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The agent's memory changed; refetch it.",
          "properties": {
            "agent_id": {
              "$ref": "#/$defs/AgentId"
            },
            "type": {
              "enum": [
                "memory_changed"
              ],
              "type": "string"
            }
          },
          "required": [
            "agent_id",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The global memory changed; refetch it.",
          "properties": {
            "type": {
              "enum": [
                "global_memory_changed"
              ],
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The agent's routines or their runs changed; refetch them.",
          "properties": {
            "agent_id": {
              "$ref": "#/$defs/AgentId"
            },
            "type": {
              "enum": [
                "routines_changed"
              ],
              "type": "string"
            }
          },
          "required": [
            "agent_id",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Who is in the operator's voice call changed (empty: it ended). `room_id`: the call's room,\nonce a second agent joined. `hung_up`: the agent whose hang-up this is; its goodbye may\nstill be playing.",
          "properties": {
            "agents": {
              "items": {
                "$ref": "#/$defs/AgentId"
              },
              "type": "array"
            },
            "hung_up": {
              "oneOf": [
                {
                  "$ref": "#/$defs/AgentId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "room_id": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "type": {
              "enum": [
                "call"
              ],
              "type": "string"
            }
          },
          "required": [
            "agents",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A call room opened, gained a member or ended; or a group was created or changed.",
          "properties": {
            "room": {
              "$ref": "#/$defs/Room"
            },
            "type": {
              "enum": [
                "room"
              ],
              "type": "string"
            }
          },
          "required": [
            "room",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Something was said in a call room or group.",
          "properties": {
            "line": {
              "$ref": "#/$defs/RoomLine"
            },
            "type": {
              "enum": [
                "room_line"
              ],
              "type": "string"
            }
          },
          "required": [
            "line",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A group was deleted.",
          "properties": {
            "room_id": {
              "format": "int64",
              "type": "integer"
            },
            "type": {
              "enum": [
                "room_deleted"
              ],
              "type": "string"
            }
          },
          "required": [
            "room_id",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Whose turn it is in a call room or group; `None`: nobody's.",
          "properties": {
            "agent": {
              "oneOf": [
                {
                  "$ref": "#/$defs/AgentId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "room_id": {
              "format": "int64",
              "type": "integer"
            },
            "type": {
              "enum": [
                "room_floor"
              ],
              "type": "string"
            }
          },
          "required": [
            "room_id",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "An agent called teammates without the operator (`call_agents`); the operator may join\nwith `POST /v1/rooms/{id}/call`.",
          "properties": {
            "host": {
              "$ref": "#/$defs/AgentId"
            },
            "room_id": {
              "format": "int64",
              "type": "integer"
            },
            "topic": {
              "type": "string"
            },
            "type": {
              "enum": [
                "agent_call"
              ],
              "type": "string"
            }
          },
          "required": [
            "room_id",
            "host",
            "topic",
            "type"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "ui-events.schema.json",
  "$ref": "#/$defs/UiEvent",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One JSON text frame pushed by the daemon on `GET /v1/ws`.",
  "title": "ferrobot UI event"
}
