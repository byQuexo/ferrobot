{
  "$defs": {
    "Agent": {
      "description": "A registered agent. Secrets (the runner token) are never part of this type.",
      "properties": {
        "avatar_rev": {
          "description": "Changes whenever the avatar changes; positive while an avatar exists.",
          "format": "int64",
          "type": "integer"
        },
        "backend": {
          "description": "Backend kind that owns the sandbox, e.g. `docker`.",
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "description": {
          "description": "One-line description shown in agent lists.",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/AgentId"
        },
        "instructions": {
          "description": "Operator-provided role handed to the model as system instructions.",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/AgentName"
        },
        "sandbox_id": {
          "description": "Backend-specific sandbox identifier (container id, sprite name, ...).",
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "description": "Last model session id reported by the runner, used for resume.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/AgentStatus"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "instructions",
        "avatar_rev",
        "status",
        "created_at"
      ],
      "type": "object"
    },
    "AgentId": {
      "description": "Stable, opaque identifier of an agent.",
      "format": "uuid",
      "type": "string"
    },
    "AgentName": {
      "description": "Human-facing, unique agent handle such as `alice` or `build-bot`.\n\nRules: 1-32 chars, lowercase ASCII letters, digits and `-`,\nmust start with a letter and must not end with `-`.\nNames double as container and volume name suffixes, so they stay DNS-safe.",
      "example": "alice",
      "pattern": "^[a-z]([a-z0-9-]{0,30}[a-z0-9])?$",
      "type": "string"
    },
    "AgentStatus": {
      "description": "Lifecycle state of an agent's sandbox as tracked by the daemon.",
      "enum": [
        "created",
        "running",
        "stopped",
        "failed"
      ],
      "type": "string"
    },
    "AgentView": {
      "allOf": [
        {
          "$ref": "#/$defs/Agent"
        },
        {
          "properties": {
            "avatar_url": {
              "description": "Relative URL of the avatar image, if one was uploaded.",
              "type": [
                "string",
                "null"
              ]
            },
            "connected": {
              "description": "Whether the agent's runner is connected right now.",
              "type": "boolean"
            },
            "presence": {
              "$ref": "#/$defs/Presence"
            },
            "unread": {
              "description": "Finished turns since the operator last marked the chat as read.",
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "connected",
            "presence",
            "unread"
          ],
          "type": "object"
        }
      ],
      "description": "An agent plus live state."
    },
    "MailMessage": {
      "description": "One message in an agent's mailbox.",
      "properties": {
        "attempts": {
          "format": "int32",
          "minimum": 0,
          "type": "integer"
        },
        "body": {
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "format": "int64",
          "type": "integer"
        },
        "recipient": {
          "$ref": "#/$defs/AgentId"
        },
        "reply_to": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "sender": {
          "$ref": "#/$defs/Sender"
        },
        "status": {
          "$ref": "#/$defs/MailStatus"
        }
      },
      "required": [
        "id",
        "sender",
        "recipient",
        "body",
        "status",
        "attempts",
        "created_at"
      ],
      "type": "object"
    },
    "MailStatus": {
      "description": "Delivery state of a mailbox message.\n\n`Pending -> InFlight -> Delivered`, or back to `Pending` when a runner\ndisconnects mid-turn, or `Failed` after too many attempts.",
      "enum": [
        "pending",
        "in_flight",
        "delivered",
        "failed"
      ],
      "type": "string"
    },
    "Presence": {
      "description": "What an agent is doing right now, for status badges.",
      "enum": [
        "working",
        "awake",
        "starting",
        "sleeping",
        "error"
      ],
      "type": "string"
    },
    "Sender": {
      "description": "Who sent a mailbox message.",
      "oneOf": [
        {
          "description": "The human operator, via the UI or HTTP API.",
          "properties": {
            "kind": {
              "enum": [
                "user"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Another agent, via the `send_message` MCP tool.",
          "properties": {
            "id": {
              "$ref": "#/$defs/AgentId",
              "description": "Another agent, via the `send_message` MCP tool."
            },
            "kind": {
              "enum": [
                "agent"
              ],
              "type": "string"
            }
          },
          "required": [
            "id",
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "A scheduled routine (by routine id).",
          "properties": {
            "id": {
              "description": "A scheduled routine (by routine id).",
              "format": "int64",
              "type": "integer"
            },
            "kind": {
              "enum": [
                "routine"
              ],
              "type": "string"
            }
          },
          "required": [
            "id",
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "StoredEvent": {
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/AgentId"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "format": "int64",
          "type": "integer"
        },
        "kind": {
          "type": "string"
        },
        "payload": {
          "description": "The event body; for runner events this is a `TurnEvent`.",
          "type": "object"
        },
        "turn_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "agent_id",
        "kind",
        "payload",
        "created_at"
      ],
      "type": "object"
    },
    "UiEvent": {
      "description": "Pushed to every UI WebSocket client.",
      "oneOf": [
        {
          "description": "A turn event was recorded (same shape as `GET /v1/agents/{id}/events`).",
          "properties": {
            "event": {
              "$ref": "#/$defs/StoredEvent"
            },
            "type": {
              "enum": [
                "event"
              ],
              "type": "string"
            }
          },
          "required": [
            "event",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Live text fragment of the assistant message being written in a turn.\nNot persisted: the final `assistant_text` event replaces it.",
          "properties": {
            "agent_id": {
              "$ref": "#/$defs/AgentId"
            },
            "text": {
              "type": "string"
            },
            "turn_id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "delta"
              ],
              "type": "string"
            }
          },
          "required": [
            "agent_id",
            "turn_id",
            "text",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "An agent was created or changed (profile, presence, unread count).",
          "properties": {
            "agent": {
              "$ref": "#/$defs/AgentView"
            },
            "type": {
              "enum": [
                "agent"
              ],
              "type": "string"
            }
          },
          "required": [
            "agent",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "An agent was deleted.",
          "properties": {
            "agent_id": {
              "$ref": "#/$defs/AgentId"
            },
            "type": {
              "enum": [
                "agent_deleted"
              ],
              "type": "string"
            }
          },
          "required": [
            "agent_id",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A mailbox message was queued or changed status.",
          "properties": {
            "message": {
              "$ref": "#/$defs/MailMessage"
            },
            "type": {
              "enum": [
                "message"
              ],
              "type": "string"
            }
          },
          "required": [
            "message",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The agent's memory changed; refetch it.",
          "properties": {
            "agent_id": {
              "$ref": "#/$defs/AgentId"
            },
            "type": {
              "enum": [
                "memory_changed"
              ],
              "type": "string"
            }
          },
          "required": [
            "agent_id",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The agent's routines or their runs changed; refetch them.",
          "properties": {
            "agent_id": {
              "$ref": "#/$defs/AgentId"
            },
            "type": {
              "enum": [
                "routines_changed"
              ],
              "type": "string"
            }
          },
          "required": [
            "agent_id",
            "type"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "ui-events.schema.json",
  "$ref": "#/$defs/UiEvent",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One JSON text frame pushed by the daemon on `GET /v1/ws`.",
  "title": "ferrobot UI event"
}
