{
  "$defs": {
    "AgentId": {
      "description": "Stable, opaque identifier of an agent.",
      "format": "uuid",
      "type": "string"
    },
    "AgentName": {
      "description": "Unique agent handle like `build-bot`: 1-32 chars of `a-z0-9-`, starting with a letter and\nnot ending with `-`, so it stays DNS-safe in sandbox resource names.",
      "example": "alice",
      "pattern": "^[a-z]([a-z0-9-]{0,30}[a-z0-9])?$",
      "type": "string"
    },
    "DaemonFrame": {
      "description": "Frames sent from the daemon to a runner.",
      "oneOf": [
        {
          "description": "First frame after a successful `hello`.",
          "properties": {
            "agent_id": {
              "$ref": "#/$defs/AgentId"
            },
            "agent_name": {
              "$ref": "#/$defs/AgentName"
            },
            "instructions": {
              "type": "string"
            },
            "protocol_version": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            },
            "resume_session_id": {
              "description": "Session to resume, if the daemon knows one.",
              "type": [
                "string",
                "null"
              ]
            },
            "tools": {
              "description": "The agent's tool groups; the runner turns off the built-in ones not listed.",
              "items": {
                "$ref": "#/$defs/ToolGroup"
              },
              "type": "array"
            },
            "type": {
              "enum": [
                "welcome"
              ],
              "type": "string"
            }
          },
          "required": [
            "protocol_version",
            "agent_id",
            "agent_name",
            "instructions",
            "tools",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Run one turn for a mailbox message.",
          "properties": {
            "body": {
              "type": "string"
            },
            "message_id": {
              "description": "`0`: a new agent's greeting turn, which has no mailbox message.",
              "format": "int64",
              "type": "integer"
            },
            "sender": {
              "$ref": "#/$defs/Sender"
            },
            "sender_name": {
              "description": "Display name of the sender (`user` or the agent name).",
              "type": "string"
            },
            "turn_id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "turn"
              ],
              "type": "string"
            }
          },
          "required": [
            "turn_id",
            "message_id",
            "sender",
            "sender_name",
            "body",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A message that arrived during turn `turn_id` (only with `hello.steering`); queued again\nunless `turn_done.steered` lists it.",
          "properties": {
            "body": {
              "type": "string"
            },
            "message_id": {
              "format": "int64",
              "type": "integer"
            },
            "sender": {
              "$ref": "#/$defs/Sender"
            },
            "sender_name": {
              "description": "Display name of the sender (`user` or the agent name).",
              "type": "string"
            },
            "turn_id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "steer"
              ],
              "type": "string"
            }
          },
          "required": [
            "turn_id",
            "message_id",
            "sender",
            "sender_name",
            "body",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Abort the running turn, if it matches.",
          "properties": {
            "turn_id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "interrupt"
              ],
              "type": "string"
            }
          },
          "required": [
            "turn_id",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The operator changed the agent's name, instructions, tools or connectors;\napplies from the next turn.",
          "properties": {
            "agent_name": {
              "$ref": "#/$defs/AgentName"
            },
            "instructions": {
              "type": "string"
            },
            "tools": {
              "items": {
                "$ref": "#/$defs/ToolGroup"
              },
              "type": "array"
            },
            "type": {
              "enum": [
                "configure"
              ],
              "type": "string"
            }
          },
          "required": [
            "agent_name",
            "instructions",
            "tools",
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "RunnerFrame": {
      "description": "Frames sent from a runner to the daemon.",
      "oneOf": [
        {
          "description": "First frame on every connection.",
          "properties": {
            "driver": {
              "description": "`claude`, `openai`, `codex`, `acp` or `mock`.",
              "type": "string"
            },
            "protocol_version": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            },
            "runner_version": {
              "type": "string"
            },
            "session_id": {
              "description": "Session id persisted on the sandbox disk, if any.",
              "type": [
                "string",
                "null"
              ]
            },
            "steering": {
              "description": "The driver can take messages during a turn (`steer`).",
              "type": "boolean"
            },
            "type": {
              "enum": [
                "hello"
              ],
              "type": "string"
            }
          },
          "required": [
            "protocol_version",
            "runner_version",
            "driver",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Progress inside a turn.",
          "properties": {
            "event": {
              "$ref": "#/$defs/TurnEvent"
            },
            "turn_id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "event"
              ],
              "type": "string"
            }
          },
          "required": [
            "turn_id",
            "event",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Turn finished (successfully or not). Exactly one per `Turn`.",
          "properties": {
            "error": {
              "type": [
                "string",
                "null"
              ]
            },
            "outcome": {
              "$ref": "#/$defs/TurnOutcome"
            },
            "result": {
              "description": "Final assistant text, if any.",
              "type": [
                "string",
                "null"
              ]
            },
            "session_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "steered": {
              "description": "Ids of `steer` messages the model saw during this turn.",
              "items": {
                "format": "int64",
                "type": "integer"
              },
              "type": "array"
            },
            "turn_id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "turn_done"
              ],
              "type": "string"
            }
          },
          "required": [
            "turn_id",
            "outcome",
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "Sender": {
      "description": "Who sent a mailbox message.",
      "oneOf": [
        {
          "description": "The human operator, via the UI or HTTP API.",
          "properties": {
            "kind": {
              "enum": [
                "user"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Another agent, via the `send_message` MCP tool.",
          "properties": {
            "id": {
              "$ref": "#/$defs/AgentId",
              "description": "Another agent, via the `send_message` MCP tool."
            },
            "kind": {
              "enum": [
                "agent"
              ],
              "type": "string"
            }
          },
          "required": [
            "id",
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "A scheduled routine (by routine id).",
          "properties": {
            "id": {
              "description": "A scheduled routine (by routine id).",
              "format": "int64",
              "type": "integer"
            },
            "kind": {
              "enum": [
                "routine"
              ],
              "type": "string"
            }
          },
          "required": [
            "id",
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "ToolGroup": {
      "description": "A group of tools an agent can have on or off. The first six are ferrobot's own MCP tools\n(enforced by the daemon), the last three the model's built-in tools (enforced by the runner).",
      "enum": [
        "team",
        "memory",
        "operator",
        "create_agents",
        "add_connectors",
        "routines",
        "shell",
        "files",
        "web"
      ],
      "type": "string"
    },
    "TurnEvent": {
      "description": "Observable steps of a turn, persisted and streamed to the UI.",
      "oneOf": [
        {
          "description": "Final text of one assistant message.",
          "properties": {
            "kind": {
              "enum": [
                "assistant_text"
              ],
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text",
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Streaming fragment of the assistant message being written. Forwarded\nlive to UI clients but not persisted; `assistant_text` follows.",
          "properties": {
            "kind": {
              "enum": [
                "assistant_delta"
              ],
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text",
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "description": "Model-assigned id that links the call to its `tool_result`.",
              "type": [
                "string",
                "null"
              ]
            },
            "input": {
              "type": "object"
            },
            "kind": {
              "enum": [
                "tool_use"
              ],
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "input",
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "is_error": {
              "type": "boolean"
            },
            "kind": {
              "enum": [
                "tool_result"
              ],
              "type": "string"
            },
            "output": {
              "description": "Tool output as text, truncated by the runner.",
              "type": "string"
            }
          },
          "required": [
            "output",
            "is_error",
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "tool_denied"
              ],
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "reason",
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "log"
              ],
              "type": "string"
            },
            "level": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "level",
            "message",
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "TurnOutcome": {
      "description": "How a turn ended.",
      "enum": [
        "completed",
        "interrupted",
        "failed"
      ],
      "type": "string"
    }
  },
  "$id": "runner-protocol.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A frame on the runner WebSocket (`/runner/ws`, agent listener): `DaemonFrame` from daemon to runner, `RunnerFrame` from runner to daemon.",
  "oneOf": [
    {
      "$ref": "#/$defs/DaemonFrame"
    },
    {
      "$ref": "#/$defs/RunnerFrame"
    }
  ],
  "title": "ferrobot runner protocol frame"
}
